{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toucan Markdown Editor",
  "version": "0.3.9",
  "identifier": "dev.tomohiko-ohhashi.markdown-editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toucan Markdown Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 BigBridge Digital. All rights reserved.",
    "publisher": "BigBridge Digital",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGRDdDRjU1NEQ1NkJCMEYKUldRUHUxWk5WYy9YejFheERJOXUyK3lhTEg5N2FTMlJDTGVEZjlzTWhVMWozRVNDUG9aRTdRTmoK",
      "endpoints": [
        "https://github.com/tomohiko-ohhashi/toucan-markdown-editor/releases/latest/download/latest.json"
      ]
    }
  }
}
